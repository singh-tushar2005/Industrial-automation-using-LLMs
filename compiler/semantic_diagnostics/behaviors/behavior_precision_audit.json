  "false_positive_analysis": {
    "test harness contamination": {
      "count": 23,
      "description": "Helper functions (OSCAT library: BIT_OF_DWORD, SHL, SHR, REFLECT, FLOOR, etc.) in test harness files are industrial-scoped but trigger behaviors unrelated to the FB under test. The test detector marks FB_TEST_1 and TestRunnerProgram as test, but top-level helper functions remain industrial-scoped."
    },
    "accumulator overfiring": {
      "count": 2,
      "description": "GEN_BIT and INCLUDE contain loop counters (rx := rx + 1, cnt := cnt + 1) and REFLECT accumulation (REFLECT := SHL(REFLECT, 1) OR ...) that are detected as accumulators but are not checksum algorithms."
    },
    "history variable overfiring": {
      "count": 4,
      "description": "Test harness files contain timing variables (tx, last, tl) from helper functions (T_PLC_MS, GEN_SIN) that trigger history_variable evidence, causing FLOW_MEASUREMENT false positives in unrelated test harnesses."
    },
    "operation threshold too low": {
      "count": 2,
      "description": "FLOW_METER_FullTest has math_ops=1 (FLOOR helper function) and iterative=1 (FOR loop in helper function), which triggers MATHEMATICAL_SOLVER via the secondary rule (math_ops >= 1 AND iterative >= 1)."
